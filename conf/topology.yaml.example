# ClusterShell cluster topology example file (YAML syntax)
#
#  rio0
#  |- rio[10-11]
#  |  `- rio[100-240]
#  `- rio[12-13]
#     `- rio[300-440]

routes:
  - gateways: rio0
    targets:  rio[10-13]
  - gateways: rio[10-11]
    targets:  rio[100-240]
  - gateways: rio[12-13]
    targets:  rio[300-440]
